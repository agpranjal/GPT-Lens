# Copy this file to `.env` and fill in your key. `.env` is gitignored.
PORT=3001

# --- OpenRouter (OpenAI-compatible; access to many models, pay-as-you-go) ---
OPENROUTER_API_KEY=your_key_here
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_MAX_TOKENS=8192
# Thinking-token budget for reasoning models (lower = faster first token)
OPENROUTER_REASONING_MAX_TOKENS=128
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
