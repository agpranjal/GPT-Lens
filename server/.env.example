# Copy this file to `.env` and fill in your key. `.env` is gitignored.
PORT=3001

# --- OpenRouter (OpenAI-compatible; access to many models, pay-as-you-go) ---
OPENROUTER_API_KEY=your_key_here
OPENROUTER_MODEL=openai/gpt-oss-120b
OPENROUTER_MAX_TOKENS=8192
# Default reasoning level: off | low | medium | high | max
OPENROUTER_REASONING=high
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Send the full main-chat history + the whole drill-down ancestor chain with
# every modal action (adds token cost/latency to every action, in exchange
# for the model always having the full context). Defaults to true; set to
# false to fall back to the leaner one-hop-back behavior.
EXTRA_CONTEXT=true
