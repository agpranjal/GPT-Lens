# Copy this file to `.env` and fill in your key. `.env` is gitignored.
PORT=3001

# --- OpenRouter (OpenAI-compatible; access to many models, pay-as-you-go) ---
OPENROUTER_API_KEY=your_key_here
OPENROUTER_MODEL=openai/gpt-5.1
OPENROUTER_MAX_TOKENS=8192
# Default reasoning level: off | low | medium | high
OPENROUTER_REASONING=off
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
